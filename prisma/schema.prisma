// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL")   // direct connection (migrations)
}

model Video {
  id              String   @id @default(cuid())
  shop            String
  title           String   @default("")
  // Storage
  videoUrl        String   // Original MP4 URL in R2
  streamUrl       String?  // HLS .m3u8 playlist URL (null until converted)
  previewUrl      String?  // Tiny card-preview clip (previews/{key}.mp4); null = card uses full video
  thumbnailUrl    String   @default("")
  duration        Int?     // seconds
  // Product link
  productId       String   @default("")
  variantId       String   @default("")
  productTitle    String   @default("")
  productUrl      String   @default("")
  productImageUrl String   @default("")
  price           Float?
  compareAtPrice  Float?
  currency        String   @default("INR")
  // Multiple tagged products (JSON array). The single fields above mirror the
  // first product for backwards compatibility.
  products        String   @default("[]")
  // Background processing (ffmpeg compress + thumbnail + preview clip).
  // progress is 0-100; error holds the reason when a run dies. Without these a
  // failed job is indistinguishable from a slow one — the card just says
  // "Processing..." forever.
  processingProgress Int?
  processingError    String?
  // Instagram provenance. Null for browser uploads. Kept so the admin can see
  // where a video came from, link back to the original post, and so the same
  // reel can't be imported twice — the existing duplicate check compares
  // videoUrl, which can't work for imports since every one gets a fresh R2 key.
  sourceIgShortcode String?
  sourceIgPermalink String?
  // Settings
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  // Analytics
  viewCount       Int      @default(0)
  atcCount        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop, sourceIgShortcode])
}

/// A merchant's connected Instagram Business or Creator account.
///
/// One row per shop: a Shopify store maps to exactly one Instagram identity.
/// This row is what proves ownership of an imported reel — we only ever read
/// media through /me/media using this token, so a reel that isn't on this
/// account cannot be reached, let alone imported.
///
/// accessToken is a long-lived (60-day) Instagram User token, encrypted at rest
/// with IG_TOKEN_ENC_KEY. It is never sent to the browser and never logged.
model InstagramAccount {
  shop           String    @id
  igUserId       String
  username       String
  accessToken    String // AES-256-GCM, "iv:tag:ciphertext" base64
  tokenExpiresAt DateTime
  /// Cached /me/media response, so the picker doesn't spend the 200-calls-per-
  /// hour budget on every render. Refreshed on demand and by an explicit
  /// Refresh button.
  mediaCache     String?
  mediaCachedAt  DateTime?
  /// Set when the merchant disconnects here, or when Meta calls the deauthorize
  /// webhook. The row is kept rather than deleted so already-imported videos
  /// retain their provenance.
  revokedAt      DateTime?
  lastError      String?
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Which of our videos appear on a product's page, and in what order.
///
/// This is the curation table. A row means "the merchant chose this video for
/// this product's page"; the storefront block reads these rows and plays the
/// files from R2. Nothing here depends on Shopify storing anything, so the
/// plan's store-wide video cap (250 on Basic) does not apply.
///
/// It ALSO still records an optional push into Shopify's own media gallery —
/// the carousel beside the price, which the theme renders from product.media
/// and which therefore does require a Shopify-hosted copy. That path is now an
/// opt-in extra for hero products, not how the product page works. When it is
/// unused, shopifyFileId is "" and status is "READY".
///
/// Position IS stored here now. Previously Shopify owned the ordering, so
/// caching it locally would have drifted; with the product page served from our
/// own data we are the source of truth.
model ProductMedia {
  id            String   @id @default(cuid())
  shop          String
  videoId       String // -> Video.id
  productId     String // Shopify product GID, e.g. gid://shopify/Product/123
  /// Order within the product's page. Lower shows first.
  position      Int      @default(0)
  /// Set only when this video was also pushed into Shopify's gallery.
  shopifyFileId String // gid://shopify/Video/456
  /// "READY" for curation-only rows. When a Shopify push is involved this
  /// mirrors Shopify's fileStatus: PENDING, UPLOADED, PROCESSING, READY, FAILED.
  /// "REMOVED" is a tombstone meaning the merchant deliberately took it off.
  status        String   @default("PENDING")
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, videoId, productId])
  @@index([shop, status])
  @@index([shop, productId, position])
}

/// Products the merchant has chosen to manage videos for.
///
/// The Manage product page screen used to derive its rows purely from videos —
/// a product appeared only because some video pointed at it. That made it
/// impossible to add a product you hadn't uploaded for yet: the row had nowhere
/// to live and vanished on refresh. A row here means "show this product in the
/// list", independently of whether it has any videos.
model ProductPage {
  id        String   @id @default(cuid())
  shop      String
  productId String // gid://shopify/Product/...
  createdAt DateTime @default(now())

  @@unique([shop, productId])
  @@index([shop])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  shop      String
  videoId   String
  type      String   // "VIEW" | "ATC"
  createdAt DateTime @default(now())

  @@index([shop, type, createdAt])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
