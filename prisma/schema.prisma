// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL")   // direct connection (migrations)
}

model Video {
  id              String   @id @default(cuid())
  shop            String
  title           String   @default("")
  // Storage
  videoUrl        String   // Original MP4 URL in R2
  streamUrl       String?  // HLS .m3u8 playlist URL (null until converted)
  previewUrl      String?  // Tiny card-preview clip (previews/{key}.mp4); null = card uses full video
  thumbnailUrl    String   @default("")
  duration        Int?     // seconds
  // Product link
  productId       String   @default("")
  variantId       String   @default("")
  productTitle    String   @default("")
  productUrl      String   @default("")
  productImageUrl String   @default("")
  price           Float?
  compareAtPrice  Float?
  currency        String   @default("INR")
  // Multiple tagged products (JSON array). The single fields above mirror the
  // first product for backwards compatibility.
  products        String   @default("[]")
  // Background processing (ffmpeg compress + thumbnail + preview clip).
  // progress is 0-100; error holds the reason when a run dies. Without these a
  // failed job is indistinguishable from a slow one — the card just says
  // "Processing..." forever.
  processingProgress Int?
  processingError    String?
  // Settings
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  // Analytics
  viewCount       Int      @default(0)
  atcCount        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Links one of our R2-hosted videos to a copy of it living in Shopify's own
/// product media gallery.
///
/// Shopify will not reference an external URL for video — it downloads the file
/// and hosts its own transcoded copy. So a video that appears in the product
/// gallery exists twice: our R2 object (used by the carousel and reel player)
/// and Shopify's file (used by the theme's gallery). This row is the mapping
/// between the two.
///
/// Position is deliberately NOT stored here. Shopify owns the ordering, and the
/// merchant can reorder media in the Shopify admin at any time; caching it
/// locally would guarantee drift.
model ProductMedia {
  id            String   @id @default(cuid())
  shop          String
  videoId       String // -> Video.id
  productId     String // Shopify product GID, e.g. gid://shopify/Product/123
  shopifyFileId String // gid://shopify/Video/456
  // Mirrors Shopify's fileStatus: PENDING (we haven't called fileCreate yet),
  // UPLOADED, PROCESSING, READY, FAILED.
  status        String   @default("PENDING")
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, videoId, productId])
  @@index([shop, status])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  shop      String
  videoId   String
  type      String   // "VIEW" | "ATC"
  createdAt DateTime @default(now())

  @@index([shop, type, createdAt])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
